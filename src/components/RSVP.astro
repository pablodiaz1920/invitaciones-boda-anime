<section id="rsvp" class="py-12 md:py-20 px-4 md:px-6 max-w-4xl mx-auto">
  <div class="anim-scale-in vintage-frame bg-paper rounded-sm p-5 md:p-12 shadow-2xl relative">
    <div class="text-center space-y-4 mb-8">
      <span class="text-[10px] md:text-xs uppercase font-bold tracking-widest text-wedding-rose bg-rose-100 px-4 py-1.5 rounded-full inline-block">Con mucho cariño</span>
      <h2 class="font-title text-2xl md:text-3xl text-stone-950">Confirmación de Asistencia</h2>
      <div class="h-1 w-20 bg-wedding-gold mx-auto rounded-full"></div>
      <p class="text-stone-600 text-xs md:text-sm font-serif-elegant italic">Por favor, confirma tu asistencia antes del 15 de Diciembre de 2026 para reservar tu lugar en nuestra celebración.</p>
    </div>

    <!-- Estado: cargando la invitación -->
    <div id="rsvp-loading" class="hidden text-center py-8 text-stone-500 text-sm">
      <i class="fa-solid fa-spinner fa-spin mr-2"></i>Buscando tu invitación...
    </div>

    <!-- Estado: sin link personal (o link inválido) -->
    <div id="rsvp-no-token" class="text-center space-y-4 py-4">
      <div class="w-16 h-16 bg-amber-100 text-amber-600 rounded-full flex items-center justify-center text-3xl shadow-md mx-auto">
        <i class="fa-solid fa-scroll"></i>
      </div>
      <h3 id="rsvp-no-token-title" class="font-title text-lg md:text-xl text-stone-950">Usa tu link personal</h3>
      <p id="rsvp-no-token-text" class="text-stone-600 text-sm max-w-md mx-auto">
        Para confirmar tu asistencia abre el link personalizado que te enviamos por WhatsApp. Así sabremos quién eres y cuántos pases tienes reservados.
      </p>
    </div>

    <!-- Estado: ya respondió -->
    <div id="rsvp-confirmed" class="hidden text-center space-y-6 py-4">
      <div id="rsvp-confirmed-icon" class="w-16 h-16 md:w-20 md:h-20 bg-green-100 text-green-600 rounded-full flex items-center justify-center text-3xl md:text-4xl shadow-md mx-auto">
        <i class="fa-solid fa-circle-check"></i>
      </div>
      <h3 id="rsvp-confirmed-title" class="font-title text-xl md:text-2xl text-stone-950">¡Ya confirmaste tu asistencia!</h3>
      <div id="rsvp-confirmed-details" class="bg-white/80 rounded-2xl p-6 max-w-lg mx-auto text-left space-y-2 text-sm md:text-base text-stone-700"></div>
      <button id="rsvp-edit-btn" type="button" class="hidden px-6 py-2 bg-rose-100 text-wedding-rose hover:bg-rose-200 font-bold uppercase text-xs tracking-wider rounded-full transition">
        <i class="fa-solid fa-pen mr-1"></i>Modificar mi respuesta
      </button>
      <p id="rsvp-confirmed-note" class="text-stone-500 text-xs italic"></p>
    </div>

    <!-- Estado: formulario -->
    <form id="rsvp-form" class="hidden space-y-6" novalidate>
      <div class="bg-white/70 rounded-xl px-4 py-3 border border-rose-200 text-sm text-stone-700">
        <span class="block text-xs uppercase font-bold text-wedding-rose tracking-wider mb-1">Invitación para</span>
        <span id="rsvp-name" class="font-semibold"></span>
        <span id="rsvp-passes-label" class="text-stone-500"></span>
      </div>

      <fieldset>
        <legend class="block text-xs uppercase font-bold text-wedding-rose tracking-wider mb-2">¿Nos acompañarás?</legend>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <label class="flex items-start gap-3 bg-white/70 border border-rose-200 rounded-xl px-4 py-3 cursor-pointer has-checked:border-rose-500 has-checked:ring-2 has-checked:ring-rose-500 transition">
            <input type="radio" name="rsvp-status" value="yes" class="mt-1 accent-rose-600" required />
            <span class="text-sm">Sí, será un honor acompañarlos</span>
          </label>
          <label class="flex items-start gap-3 bg-white/70 border border-rose-200 rounded-xl px-4 py-3 cursor-pointer has-checked:border-rose-500 has-checked:ring-2 has-checked:ring-rose-500 transition">
            <input type="radio" name="rsvp-status" value="no" class="mt-1 accent-rose-600" />
            <span class="text-sm">Lamentablemente no podré asistir</span>
          </label>
        </div>
      </fieldset>

      <div id="rsvp-yes-fields" class="hidden space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label for="rsvp-attending" class="block text-xs uppercase font-bold text-wedding-rose tracking-wider mb-2">¿Cuántas personas asistirán?</label>
            <select id="rsvp-attending" class="w-full px-4 py-3 rounded-xl border border-rose-200 focus:ring-2 focus:ring-rose-500 focus:border-rose-500 outline-none text-sm transition bg-white/70"></select>
          </div>
          <div>
            <label for="rsvp-food" class="block text-xs uppercase font-bold text-wedding-rose tracking-wider mb-2">Restricciones Alimenticias (Opcional)</label>
            <input type="text" id="rsvp-food" maxlength="300" placeholder="Alergias, vegano, vegetariano, etc." class="w-full px-4 py-3 rounded-xl border border-rose-200 focus:ring-2 focus:ring-rose-500 focus:border-rose-500 outline-none text-sm transition bg-white/70" />
          </div>
        </div>

        <div>
          <label for="rsvp-song" class="block text-xs uppercase font-bold text-wedding-rose tracking-wider mb-2">Canción que no puede faltar en la pista (Opcional)</label>
          <input type="text" id="rsvp-song" maxlength="200" placeholder="Canción - Artista" class="w-full px-4 py-3 rounded-xl border border-rose-200 focus:ring-2 focus:ring-rose-500 focus:border-rose-500 outline-none text-sm transition bg-white/70" />
        </div>
      </div>

      <div>
        <label for="rsvp-message" class="block text-xs uppercase font-bold text-wedding-rose tracking-wider mb-2">Mensaje especial para Debora & Pablo (Opcional)</label>
        <textarea id="rsvp-message" rows="4" maxlength="1000" placeholder="Déjanos unas palabras, un consejo o tus mejores deseos..." class="w-full px-4 py-3 rounded-xl border border-rose-200 focus:ring-2 focus:ring-rose-500 focus:border-rose-500 outline-none text-sm transition bg-white/70"></textarea>
      </div>

      <p id="rsvp-error" class="hidden text-center text-sm text-red-600" role="alert"></p>

      <div class="text-center pt-4 flex flex-col-reverse md:flex-row items-center justify-center gap-3">
        <button id="rsvp-cancel-btn" type="button" class="hidden px-6 py-3 text-wedding-rose hover:underline font-bold uppercase text-xs tracking-wider">
          Cancelar
        </button>
        <button id="rsvp-submit" type="submit" class="bg-wedding-rose text-white hover:brightness-110 hover:scale-105 active:scale-95 disabled:opacity-60 disabled:hover:scale-100 transition shadow-lg px-8 py-4 rounded-full font-bold uppercase tracking-wider text-xs md:text-sm flex items-center justify-center space-x-2 w-full md:w-auto">
          <i class="fa-solid fa-paper-plane"></i>
          <span>Confirmar mi asistencia</span>
        </button>
      </div>
    </form>
  </div>
</section>
