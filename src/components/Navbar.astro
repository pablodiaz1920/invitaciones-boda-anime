---
// "sections": secciones que activan cada enlace al hacer scroll
const links = [
  { href: '#historia', label: 'Historia', sections: 'historia' },
  { href: '#galeria', label: 'Galería', sections: 'galeria' },
  { href: '#detalles', label: 'El Día', sections: 'detalles' },
  { href: '#regalos', label: 'Regalos', sections: 'regalos' },
];
---

<header id="site-header" class="sticky top-0 z-40 bg-white/90 backdrop-blur-md border-b border-rose-100 shadow-sm">
  <div class="max-w-6xl mx-auto h-14 md:h-16 px-4 md:px-6 flex items-center justify-between gap-4">
    <a href="#inicio" class="font-title text-wedding-rose text-lg md:text-2xl font-bold tracking-wider whitespace-nowrap" aria-label="Ir al inicio">D & P</a>

    <nav aria-label="Secciones" class="hidden md:flex items-center gap-6 lg:gap-10 text-xs lg:text-sm font-semibold uppercase tracking-wider whitespace-nowrap">
      {links.map((l) => (
        <a href={l.href} data-sections={l.sections} class="nav-link py-2 border-b-2 border-transparent hover:text-wedding-rose transition">{l.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-1">
      <a href="#rsvp" data-sections="rsvp" class="nav-cta bg-wedding-rose text-white hover:brightness-110 active:scale-95 transition px-4 py-2 rounded-full text-xs md:text-sm uppercase tracking-wider font-bold shadow-md whitespace-nowrap">
        Confirmar
      </a>
      <button id="menu-toggle" type="button" class="md:hidden text-wedding-rose text-xl w-10 h-10 flex items-center justify-center rounded-full hover:bg-rose-50 transition" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu">
        <i class="fa-solid fa-bars" aria-hidden="true"></i>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" aria-label="Secciones" class="md:hidden hidden border-t border-rose-100 bg-white">
    <ul class="max-w-6xl mx-auto px-4 py-3 grid grid-cols-2 gap-2">
      {links.map((l) => (
        <li>
          <a href={l.href} data-sections={l.sections} class="nav-link block text-center py-3 rounded-xl bg-rose-50/60 text-sm font-semibold uppercase tracking-wider text-wedding-dark hover:bg-rose-100 transition">{l.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>
