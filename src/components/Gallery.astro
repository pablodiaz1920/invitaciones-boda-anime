---
import { Image, getImage } from 'astro:assets';
import img0356 from '../assets/IMG_0356.webp';
import img0539 from '../assets/IMG_0539.webp';
import img0591 from '../assets/IMG_0591.webp';
import img0623 from '../assets/IMG_0623.webp';
import img0655 from '../assets/IMG_0655.webp';
import img0873 from '../assets/IMG_0873.webp';
import img0486 from '../assets/IMG_0486.webp';
import img1031 from '../assets/IMG_1031.webp';

const photos = [
  { src: img0356, caption: 'Donde todo comenzó', rotate: 'rotate-[-2deg]' },
  { src: img0539, caption: 'El comienzo del camino', rotate: 'rotate-[-1deg]' },
  { src: img0591, caption: 'Lo que el destino guardó', rotate: 'rotate-[2deg]' },
  { src: img0623, caption: 'Promesa de amor eterno', rotate: 'rotate-[-1.5deg]' },
  { src: img0655, caption: 'Entre flores y promesas', rotate: 'rotate-[1deg]' },
  { src: img0873, caption: 'Caminando juntos', rotate: 'rotate-[-2.5deg]' },
  { src: img0486, caption: 'Corriendo hacia nuestro siempre', rotate: 'rotate-[1.5deg]' },
  { src: img1031, caption: 'Para siempre, juntos', rotate: 'rotate-[2.5deg]' },
];

// Versiones grandes solo para la vista a pantalla completa (se cargan al abrirla)
const fullSize = await Promise.all(
  photos.map(async (p) => {
    const img = await getImage({ src: p.src, width: 1920, widths: [800, 1280, 1920], format: 'webp', quality: 80 });
    return { src: img.src, srcset: img.srcSet.attribute, caption: p.caption };
  })
);
---

<section id="galeria" class="py-12 md:py-20 px-4 md:px-6 max-w-6xl mx-auto">
  <div class="text-center max-w-2xl mx-auto mb-10 md:mb-16 space-y-3">
    <h2 class="anim-fade-in-up font-title text-2xl sm:text-3xl md:text-4xl text-wedding-rose">Nuestros Recuerdos</h2>
    <div class="h-1 w-24 bg-wedding-gold mx-auto rounded-full"></div>
    <p class="anim-fade-in-up text-stone-600 font-serif-elegant text-sm md:text-base italic">Instantes que guardamos como postales de un viaje que apenas comienza.</p>
    <p class="text-xs text-stone-500"><i class="fa-solid fa-expand mr-1" aria-hidden="true"></i>Toca cualquier foto para verla en pantalla completa</p>
  </div>

  <!-- Cinta de película animada -->
  <div class="anim-fade-in-up relative -mx-4 md:-mx-6 mb-12 md:mb-16 overflow-hidden bg-stone-950 py-4 border-y-4 border-rose-800/40 marquee">
    <div class="marquee-track flex w-max will-change-transform">
      {[0, 1].map((copy) => (
        <div class="flex gap-3 pr-3" aria-hidden={copy === 1 ? 'true' : undefined}>
          {photos.map((photo, i) => (
            <button type="button" class="gallery-open shrink-0 rounded-lg focus-visible:outline-2 focus-visible:outline-gold-light cursor-zoom-in" data-index={i} tabindex={copy === 1 ? -1 : undefined} aria-label={`Ver "${photo.caption}" en pantalla completa`}>
              <Image src={photo.src} alt="" height={224} quality={70} class="h-20 md:h-28 w-auto rounded-lg object-cover border-2 border-gold-light/40 shadow-lg" loading="lazy" decoding="async" />
            </button>
          ))}
        </div>
      ))}
    </div>
    <div class="absolute inset-y-0 left-0 w-16 bg-linear-to-r from-stone-950 to-transparent pointer-events-none"></div>
    <div class="absolute inset-y-0 right-0 w-16 bg-linear-to-l from-stone-950 to-transparent pointer-events-none"></div>
  </div>

  <!-- Galería estilo polaroid -->
  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-x-4 gap-y-6 md:gap-8">
    {photos.map((photo, i) => (
      <figure class={`anim-fade-in-up ${photo.rotate} hover:rotate-0 transition-transform duration-500 bg-white p-2 md:p-3 pb-3 md:pb-4 rounded-xl shadow-lg border border-amber-100`}>
        <button type="button" class="gallery-open group relative block w-full overflow-hidden rounded-lg aspect-[3/4] cursor-zoom-in focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-wedding-rose" data-index={i} aria-label={`Ver "${photo.caption}" en pantalla completa`}>
          <Image
            src={photo.src}
            alt={photo.caption}
            width={640}
            widths={[320, 480, 640]}
            sizes="(min-width: 1024px) 260px, (min-width: 768px) 33vw, 50vw"
            quality={75}
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
            loading="lazy"
            decoding="async"
          />
          <span class="absolute bottom-2 right-2 w-8 h-8 rounded-full bg-black/50 text-white text-xs flex items-center justify-center opacity-80 group-hover:opacity-100 transition" aria-hidden="true">
            <i class="fa-solid fa-expand"></i>
          </span>
        </button>
        <figcaption class="mt-2 md:mt-3 text-center">
          <span class="block text-[11px] md:text-xs font-bold uppercase tracking-wider text-wedding-rose font-title leading-snug">{photo.caption}</span>
        </figcaption>
      </figure>
    ))}
  </div>
</section>

<!-- Visor a pantalla completa -->
<dialog id="lightbox" class="lightbox" aria-label="Galería de fotos en pantalla completa">
  <div class="h-full w-full flex flex-col">
    <div class="flex items-center justify-between gap-2 px-3 md:px-6 py-3 shrink-0">
      <span id="lightbox-counter" class="text-sm text-stone-300 tabular-nums" aria-live="polite"></span>
      <div class="flex items-center gap-1">
        <button id="lightbox-fullscreen" type="button" class="hidden w-11 h-11 rounded-full hover:bg-white/10 text-lg transition" aria-label="Pantalla completa">
          <i class="fa-solid fa-expand" aria-hidden="true"></i>
        </button>
        <button id="lightbox-close" type="button" class="w-11 h-11 rounded-full hover:bg-white/10 text-2xl transition" aria-label="Cerrar">
          <i class="fa-solid fa-xmark" aria-hidden="true"></i>
        </button>
      </div>
    </div>

    <div id="lightbox-stage" class="relative flex-1 min-h-0 flex items-center justify-center px-2 md:px-20">
      <i id="lightbox-spinner" class="fa-solid fa-spinner fa-spin text-3xl text-stone-400 absolute" aria-hidden="true"></i>
      <img id="lightbox-img" alt="" sizes="100vw" class="max-h-full max-w-full object-contain select-none rounded-md shadow-2xl transition-opacity duration-200" draggable="false" />
      <button type="button" class="lightbox-prev hidden md:flex items-center justify-center absolute left-4 top-1/2 -translate-y-1/2 w-14 h-14 rounded-full bg-white/10 hover:bg-white/20 text-2xl transition" aria-label="Foto anterior">
        <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
      </button>
      <button type="button" class="lightbox-next hidden md:flex items-center justify-center absolute right-4 top-1/2 -translate-y-1/2 w-14 h-14 rounded-full bg-white/10 hover:bg-white/20 text-2xl transition" aria-label="Foto siguiente">
        <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
      </button>
    </div>

    <div class="shrink-0 flex items-center justify-between gap-2 px-3 md:px-6 py-3 md:py-4">
      <button type="button" class="lightbox-prev md:hidden w-11 h-11 shrink-0 rounded-full bg-white/10 active:bg-white/20 text-lg" aria-label="Foto anterior">
        <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
      </button>
      <p id="lightbox-caption" class="flex-1 text-center font-title text-sm md:text-base text-gold-light"></p>
      <button type="button" class="lightbox-next md:hidden w-11 h-11 shrink-0 rounded-full bg-white/10 active:bg-white/20 text-lg" aria-label="Foto siguiente">
        <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
      </button>
    </div>
  </div>
</dialog>

<script type="application/json" id="gallery-data" set:html={JSON.stringify(fullSize)} />

<script>
  type Photo = { src: string; srcset: string; caption: string };

  const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
  const dataEl = document.getElementById('gallery-data');

  if (dialog && dataEl) {
    const photos: Photo[] = JSON.parse(dataEl.textContent || '[]');
    const img = document.getElementById('lightbox-img') as HTMLImageElement;
    const caption = document.getElementById('lightbox-caption')!;
    const counter = document.getElementById('lightbox-counter')!;
    const stage = document.getElementById('lightbox-stage')!;
    const fsBtn = document.getElementById('lightbox-fullscreen')!;
    const spinner = document.getElementById('lightbox-spinner')!;
    let index = 0;
    let lastTrigger: HTMLElement | null = null;

    const preload = (i: number) => {
      const p = photos[(i + photos.length) % photos.length];
      const pre = new Image();
      pre.sizes = '100vw';
      pre.srcset = p.srcset;
      pre.src = p.src;
    };

    const show = (i: number) => {
      index = (i + photos.length) % photos.length;
      const p = photos[index];
      img.style.opacity = '0';
      spinner.classList.remove('hidden');
      img.onload = img.onerror = () => {
        img.style.opacity = '1';
        spinner.classList.add('hidden');
      };
      img.srcset = p.srcset;
      img.src = p.src;
      img.alt = p.caption;
      caption.textContent = p.caption;
      counter.textContent = `${index + 1} / ${photos.length}`;
      preload(index + 1);
      preload(index - 1);
    };

    const open = (i: number, trigger: HTMLElement) => {
      lastTrigger = trigger;
      show(i);
      document.documentElement.style.overflow = 'hidden';
      dialog.showModal();
    };

    dialog.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
      if (document.fullscreenElement) document.exitFullscreen().catch(() => {});
      lastTrigger?.focus({ preventScroll: true });
    });

    document.querySelectorAll<HTMLElement>('.gallery-open').forEach((btn) => {
      btn.addEventListener('click', () => open(Number(btn.dataset.index), btn));
    });

    document.getElementById('lightbox-close')!.addEventListener('click', () => dialog.close());
    document.querySelectorAll('.lightbox-prev').forEach((b) => b.addEventListener('click', () => show(index - 1)));
    document.querySelectorAll('.lightbox-next').forEach((b) => b.addEventListener('click', () => show(index + 1)));

    // Cerrar al tocar el fondo (fuera de la foto y de los botones)
    stage.addEventListener('click', (e) => { if (e.target === stage) dialog.close(); });

    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); show(index - 1); }
      if (e.key === 'ArrowRight') { e.preventDefault(); show(index + 1); }
    });

    // Deslizar con el dedo
    let startX = 0;
    let startY = 0;
    stage.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; startY = e.touches[0].clientY; }, { passive: true });
    stage.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      const dy = e.changedTouches[0].clientY - startY;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) show(dx < 0 ? index + 1 : index - 1);
    }, { passive: true });

    // Pantalla completa real del dispositivo, donde el navegador lo permite
    if (document.fullscreenEnabled) {
      fsBtn.classList.remove('hidden');
      const fsIcon = fsBtn.querySelector('i')!;
      fsBtn.addEventListener('click', () => {
        if (document.fullscreenElement) document.exitFullscreen();
        else dialog.requestFullscreen().catch(() => {});
      });
      document.addEventListener('fullscreenchange', () => {
        const on = Boolean(document.fullscreenElement);
        fsIcon.className = on ? 'fa-solid fa-compress' : 'fa-solid fa-expand';
        fsBtn.setAttribute('aria-label', on ? 'Salir de pantalla completa' : 'Pantalla completa');
      });
    }
  }
</script>
