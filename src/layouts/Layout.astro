---
import '../styles/global.css';

export interface Props {
  title?: string;
  noindex?: boolean;
}

const { title = "Debora & Pablo · 30 de enero de 2027", noindex = false } = Astro.props;
const site = Astro.site ?? new URL('https://pablodiaz1920.github.io');
const currentUrl = new URL(Astro.url.pathname, site);
const ogImage = new URL('/invitaciones-boda-anime/og-image.jpg', site).href;
const description = "Débora & Pablo se casan el 30 de Enero de 2027. Te invitamos a celebrar con nosotros el comienzo de nuestro viaje juntos, en una boda inspirada en la elegancia y la serenidad de Japón.";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/jpeg" href="/invitaciones-boda-anime/favicon.jpeg?v=4" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="keywords" content="boda, invitación de boda, japón, sakura, boda inspirada en Japón, débora, pablo, república dominicana, santo domingo" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={currentUrl.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="canonical" href={currentUrl.href} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Montserrat:wght@300;400;600;700&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

  </head>
  <body class="bg-wedding-bg text-wedding-dark min-h-screen font-sans overflow-x-hidden">
    <!-- Pétalos por detrás del contenido: nunca tapan texto ni imágenes -->
    <canvas id="sakura-canvas" class="fixed inset-0 w-full h-full pointer-events-none -z-10" aria-hidden="true"></canvas>

    <div id="toast" role="status" aria-live="polite" class="fixed top-20 left-1/2 -translate-x-1/2 -translate-y-4 max-w-[calc(100vw-2rem)] text-center bg-wedding-rose text-white text-xs uppercase font-bold tracking-wider px-5 py-2.5 md:px-6 md:py-3 rounded-xl shadow-2xl border border-rose-700 opacity-0 pointer-events-none transition-all duration-300 z-50">
      ¡Copiado al portapapeles!
    </div>

    <slot />

    <button id="back-to-top" type="button" aria-label="Volver arriba" class="back-to-top fixed right-4 md:right-6 z-30 w-11 h-11 md:w-12 md:h-12 rounded-full bg-wedding-rose text-white shadow-lg border-2 border-white flex items-center justify-center hover:brightness-110 active:scale-95 transition-all duration-300 opacity-0 translate-y-4 pointer-events-none">
      <i class="fa-solid fa-arrow-up" aria-hidden="true"></i>
    </button>

    <script>
      import '../scripts/sakura.js';
      import '../scripts/main.js';
    </script>
  </body>
</html>
